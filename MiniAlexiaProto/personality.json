      { "id": "h8",  "text": "{hoursSinceSend} without a proper tribute~", "expects": "feed" },
      { "id": "h9",  "mood": "angry", "text": "feed me dumbass", "expects": "feed" },
      { "id": "h10", "text": "my stomach > your budget~", "expects": "feed" },
      { "id": "h11", "text": "I'm hungry and you're the menu~", "expects": "feed" },
      { "id": "h12", "text": "your wallet's been resting long enough~", "expects": "feed" }
