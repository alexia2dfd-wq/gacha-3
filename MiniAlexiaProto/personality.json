  "dialogues": [
    { "id": "missMe", "text": "Miss me?~", "expects": "obey",
      "answers": [
        { "label": "obviously~", "msg": { "action": "obey" } },
        { "label": "hopelessly~", "msg": { "action": "obey", "big": true } }
      ],
      "timeout": { "action": "disobey" } },
    { "id": "command", "text": "go stare at your goddess for a bit~", "expects": "obey",
      "answers": [
        { "label": "obey", "open": "https://x.com/bratgodalexia", "msg": { "action": "obey", "big": true } },
        { "label": "later~", "msg": { "action": "disobey" } }
      ],
      "timeout": { "action": "disobey" } },
    { "id": "feedMe", "text": "More for your favorite succubus~", "expects": "feed",
      "answers": [
        { "label": "more~", "open": "https://throne.com/brattyalexia", "msg": { "action": "obey", "big": true } },
        { "label": "later~", "msg": { "action": "disobey" } }
      ],
      "timeout": { "action": "disobey" } },
    { "id": "favorite", "text": "I'm your most important expense~ right?", "expects": "obey",
