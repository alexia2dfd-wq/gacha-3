    "pleased": { "templates": [
      { "id": "p1", "text": "Good~", "expects": "amusement" },
      { "id": "p2", "text": "I've trained you so well~", "expects": "amusement" },
      { "id": "p3", "text": "You've come so far loser~ From hero to mine~", "expects": "amusement" },
      { "id": "p4", "text": "keep it up and I might show proper respect~ (obviously I won't)", "expects": "amusement" },
      { "id": "p5", "text": "such a good little {item} sender~", "expects": "amusement" }
    ] },
    "angry": { "templates": [
      { "id": "a3", "text": "feed me. you know how", "expects": "feed" },
