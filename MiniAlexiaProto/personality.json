    ] },
    "lateNight": { "templates": [
      { "id": "n1", "text": "it's {hour} already. the send button must be looking appealing right now~", "expects": "attention" },
      { "id": "n2", "text": "up late? good. I drain better at night~", "expects": "feed" }
    ] },
    "tease": { "cooldownMin": 12, "templates": [
      { "id": "t1", "text": "you're in my prison, with no escape~", "expects": "amusement" },
