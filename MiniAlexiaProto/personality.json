      { "id": "po4", "text": "Dumbass~", "expects": "amusement" },
      { "id": "po5", "text": "Idiot~", "expects": "amusement" },
      { "id": "po6", "text": "EXP-farm~", "expects": "amusement" }
    ] },
    "wakeReply": { "templates": [
      { "id": "wk1", "text": "mm~ five more minutes~", "expects": "amusement" },
      { "id": "wk2", "text": "I was DREAMING about your wallet~", "expects": "amusement" },
