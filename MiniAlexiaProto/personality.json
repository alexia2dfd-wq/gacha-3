    "chill": { "cooldownMin": 20, "templates": [
      { "id": "c1", "text": "shh. watching~", "expects": "amusement" },
      { "id": "c2", "text": "good episode. would be better with tribute~", "expects": "amusement" },
      { "id": "c3", "mood": "bored", "text": "Are we both just pretending this garbage is good?~", "expects": "amusement" }
    ] }
