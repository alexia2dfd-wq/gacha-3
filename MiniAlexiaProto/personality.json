      "answers": [
        { "label": "goodnight warden~", "open": "https://throne.com/brattyalexia", "msg": { "action": "obey", "big": true } },
        { "label": "I'm broke", "msg": { "action": "disobey" } }
      ],
      "timeout": { "action": "disobey" } },
    { "id": "grovel", "text": "grovel. convincingly~", "expects": "obey",
      "answers": [
        { "label": "*grovels*", "msg": { "action": "obey", "big": true } },
        { "label": "no", "msg": { "action": "disobey" } }
      ],
      "timeout": { "action": "disobey" } }
