    ] },
    "intent": { "templates": [
      { "id": "i1", "text": "fufu~ watch this~", "expects": "intent" },
      { "id": "i2", "text": "plotting. expensive plotting~", "expects": "intent" },
      { "id": "i3", "text": "you'll see~", "expects": "intent" }
    ] },
    "milestone": { "templates": [
      { "id": "m1", "text": "Fuhahaha. so much EXP~", "expects": "amusement" },
