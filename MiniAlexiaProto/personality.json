      { "id": "wk4", "text": "waking me costs extra~", "expects": "amusement" },
      { "id": "wk5", "mood": "angry", "text": "I don't do mornings. or patience.", "expects": "amusement" }
    ] },
    "greeting": { "templates": [
      { "id": "g1", "text": "back~? you know you'll never escape~", "expects": "attention" },
      { "id": "g2", "text": "there you are. doomed as always~", "expects": "attention" },
      { "id": "g3", "text": "welcome back to the trap~", "expects": "attention" }
